{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "paths": {
      "@firebase/auth": ["./node_modules/@firebase/auth/dist/index.rn.d.ts"],
      "@customComponents/*": ["./src/frontend/customComponents/*"],
      "@components/*": ["./src/frontend/components/*"],
      "@translation/*": ["./src/frontend/translation/*"],
      "@locale/*": ["./src/frontend/translation/locale/*"],
      "@backend/*": ["./src/backend/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
